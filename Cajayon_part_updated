# ADD MOVIE AT BEGINNING
def add_beginning(self, new_movie):

    # CHECK DUPLICATE
    if self.is_duplicate(new_movie.title):
        print("Movie title already exists.")
        return

    # EMPTY LIST
    if self.head is None:

        # SET HEAD AND TAIL
        self.head = new_movie
        self.tail = new_movie

        # POINT TO ITSELF
        new_movie.next = new_movie
        new_movie.prev = new_movie

        # SET CURRENT
        self.current = self.head

    else:

        # GET LAST NODE
        temp = self.tail

        # NEW NODE POINTS TO HEAD
        new_movie.next = self.head

        # NEW NODE POINTS TO TAIL
        new_movie.prev = temp

        # TAIL POINTS TO NEW NODE
        temp.next = new_movie

        # OLD HEAD POINTS BACK TO NEW NODE
        self.head.prev = new_movie

        # MOVE HEAD
        self.head = new_movie

    # SUCCESS MESSAGE
    print("Movie added successfully.")

# ADD MOVIE AT END
def add_end(self, new_movie):

    # CHECK DUPLICATE
    if self.is_duplicate(new_movie.title):
        print("Movie title already exists.")
        return

    # EMPTY LIST
    if self.head is None:

        # SET HEAD AND TAIL
        self.head = new_movie
        self.tail = new_movie

        # POINT TO ITSELF
        new_movie.next = new_movie
        new_movie.prev = new_movie

        # SET CURRENT
        self.current = self.head

    else:

        # GET LAST NODE
        temp = self.tail

        # LAST NODE POINTS TO NEW NODE
        temp.next = new_movie

        # NEW NODE POINTS BACK TO LAST NODE
        new_movie.prev = temp

        # NEW NODE POINTS TO HEAD
        new_movie.next = self.head

        # HEAD POINTS BACK TO NEW TAIL
        self.head.prev = new_movie

        # UPDATE TAIL
        self.tail = new_movie

    # SUCCESS MESSAGE
    print("Movie added successfully.")

# ADD MOVIE AT POSITION
